# Copy to .env and fill in your keys. .env is gitignored — never commit real secrets.

# --- Model (resolved by configs/model_config.py; default provider is Gemini) ---
GOOGLE_API_KEY=your-gemini-api-key-here
AGENT_MODEL=gemini-2.5-flash

# To use another provider via LiteLLM instead, e.g.:
#   LLM_PROVIDER=anthropic
#   AGENT_MODEL=claude-sonnet-4-6
#   ANTHROPIC_API_KEY=...
# (OpenAI: LLM_PROVIDER=openai, AGENT_MODEL=gpt-4o, OPENAI_API_KEY=...)

# --- Kaggle (optional; for Kaggle MCP ingestion, wired in M2) ---
# Either set these or put credentials in ~/.kaggle/kaggle.json
# KAGGLE_USERNAME=
# KAGGLE_KEY=
